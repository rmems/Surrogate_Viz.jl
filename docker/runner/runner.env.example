# Copy this file to runner.env and fill in your values.
# NEVER commit runner.env or real tokens.
#
# For registration:
# 1. Go to https://github.com/rmems/Surrogate_Viz.jl/settings/actions/runners
# 2. Click "New self-hosted runner" (or use existing)
# 3. Generate a registration token (short-lived) OR use a fine-grained PAT
#    with "Self-hosted runners" read/write permission on this repo.
#
# The token is used only for ./config.sh the first time (or with --replace).
GITHUB_TOKEN=your_pat_or_registration_token_here
